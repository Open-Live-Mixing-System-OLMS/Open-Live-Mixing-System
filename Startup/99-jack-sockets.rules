# Udev rules for JACK Socket Permissions
# Allows user francesco_ssh to manage JACK sockets without sudo
# Copy this file to /etc/udev/rules.d/99-jack-sockets.rules

# Rules for JACK sockets in /dev/shm
KERNEL=="jack*", SUBSYSTEM=="", ACTION=="add", GROUP="audio", MODE="0666"
KERNEL=="jack*", SUBSYSTEM=="", ACTION=="remove", GROUP="audio", MODE="0666"

# Rules for JACK sockets in /tmp (if managed by udev)
KERNEL=="jack*", SUBSYSTEM=="", ACTION=="add", GROUP="audio", MODE="0666"
KERNEL=="jack*", SUBSYSTEM=="", ACTION=="remove", GROUP="audio", MODE="0666"

# Rules for JACK shared memory registry
KERNEL=="jack-shm-registry", SUBSYSTEM=="", ACTION=="add", GROUP="audio", MODE="0666"

# Rules for specific JACK sockets
KERNEL=="jack-olms-*", SUBSYSTEM=="", ACTION=="add", GROUP="audio", MODE="0666"
KERNEL=="jack-default_*", SUBSYSTEM=="", ACTION=="add", GROUP="audio", MODE="0666"
KERNEL=="jack_sem.*", SUBSYSTEM=="", ACTION=="add", GROUP="audio", MODE="0666"

# Usage instructions:
# 1. Copy this file to /etc/udev/rules.d/99-jack-sockets.rules
# 2. Reload udev rules: sudo udevadm control --reload-rules
# 3. Restart devices: sudo udevadm trigger
# 4. Restart the system or user session
