@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix time:  <http://lv2plug.in/ns/ext/time#> .
@prefix ui:    <http://lv2plug.in/ns/extensions/ui#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix urid:  <http://lv2plug.in/ns/ext/urid#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

plug:comp_style
	a lv2:Parameter ;
	rdfs:label "Compressor Style" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 3	 ;
	lv2:portProperty lv2:enumeration ;
	lv2:scalePoint [
		rdfs:label "Clean" ;
		rdf:value 0 ;
	], [
		rdfs:label "Classic" ;
		rdf:value 1 ;
	], [
		rdfs:label "Optical" ;
		rdf:value 2 ;
	], [
		rdfs:label "Vocal" ;
		rdf:value 3 ;
	] .

plug:comp_direction
	a lv2:Parameter ;
	rdfs:label "Compression Direction" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 3	 ;
	lv2:portProperty lv2:enumeration ;
	lv2:scalePoint [
		rdfs:label "Compress" ;
		rdf:value 0 ;
	], [
		rdfs:label "Inflate" ;
		rdf:value 1 ;
	], [
		rdfs:label "Expand" ;
		rdf:value 2 ;
	], [
		rdfs:label "Shape" ;
		rdf:value 3 ;
	] .

plug:threshold
	a lv2:Parameter ;
	rdfs:label "Threshold (dB)" ;
	rdfs:range atom:Float ;
	lv2:default -32 ;
	lv2:minimum -100 ;
	lv2:maximum 0 .

plug:ratio
	a lv2:Parameter ;
	rdfs:label "Ratio" ;
	rdfs:range atom:Float ;
	lv2:default 3 ;
	lv2:minimum 1 ;
	lv2:maximum 100 .

plug:knee_width
	a lv2:Parameter ;
	rdfs:label "Knee Width" ;
	rdfs:range atom:Float ;
	lv2:default 8 ;
	lv2:minimum 0 ;
	lv2:maximum 32 .

