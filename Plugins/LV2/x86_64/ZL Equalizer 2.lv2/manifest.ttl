@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix pset:  <http://lv2plug.in/ns/ext/presets#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix ui:    <http://lv2plug.in/ns/extensions/ui#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

<https://github.com/ZL-Audio/ZLEqualizer2>
	a lv2:Plugin ;
	lv2:binary <libZL%20Equalizer%202.so> ;
	rdfs:seeAlso <dsp.ttl> .

<https://github.com/ZL-Audio/ZLEqualizer2:UI>
	a ui:X11UI ;
	lv2:binary <libZL%20Equalizer%202.so> ;
	rdfs:seeAlso <ui.ttl> .

<https://github.com/ZL-Audio/ZLEqualizer2:preset1>
	a pset:Preset ;
	lv2:appliesTo <https://github.com/ZL-Audio/ZLEqualizer2> ;
	rdfs:label "" ;
	state:state [ <https://github.com/ZL-Audio/ZLEqualizer2:Program> "0"^^xsd:int ; ] .

