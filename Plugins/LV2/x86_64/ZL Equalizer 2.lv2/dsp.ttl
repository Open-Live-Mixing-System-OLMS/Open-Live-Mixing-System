	lv2:maximum 40 .

plug:dynamic_rms_mix23
	a lv2:Parameter ;
	rdfs:label "Dynamic RMS Mix23" ;
	rdfs:range atom:Float ;
	lv2:default 50 ;
	lv2:minimum 0 ;
	lv2:maximum 100 .

plug:dynamic_smooth23
	a lv2:Parameter ;
	rdfs:label "Dynamic Smooth23" ;
	rdfs:range atom:Float ;
	lv2:default 100 ;
	lv2:minimum 0 ;
	lv2:maximum 100 .

plug:side_filter_type23
	a lv2:Parameter ;
	rdfs:label "Side Filter Type23" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 2	 ;
	lv2:portProperty lv2:enumeration ;
	lv2:scalePoint [
		rdfs:label "BP" ;
		rdf:value 0 ;
	], [
		rdfs:label "LP" ;
		rdf:value 1 ;
	], [
		rdfs:label "HP" ;
		rdf:value 2 ;
	] .

plug:side_order23
	a lv2:Parameter ;
	rdfs:label "Side Order23" ;
	rdfs:range atom:Float ;
	lv2:default 1 ;
	lv2:minimum 0 ;
	lv2:maximum 6	 ;
	lv2:portProperty lv2:enumeration ;
	lv2:scalePoint [
		rdfs:label "6 dB/oct" ;
		rdf:value 0 ;
	], [
		rdfs:label "12 dB/oct" ;
		rdf:value 1 ;
	], [
		rdfs:label "24 dB/oct" ;
		rdf:value 2 ;
	], [
		rdfs:label "36 dB/oct" ;
		rdf:value 3 ;
	], [
		rdfs:label "48 dB/oct" ;
		rdf:value 4 ;
	], [
		rdfs:label "72 dB/oct" ;
		rdf:value 5 ;
	], [
		rdfs:label "96 dB/oct" ;
		rdf:value 6 ;
	] .

plug:side_freq23
	a lv2:Parameter ;
	rdfs:label "Side Freq23" ;
	rdfs:range atom:Float ;
	lv2:default 1000 ;
	lv2:minimum 10 ;
	lv2:maximum 160000 .

plug:side_q23
	a lv2:Parameter ;
	rdfs:label "Side Q23" ;
	rdfs:range atom:Float ;
	lv2:default 0.707 ;
	lv2:minimum 0.025 ;
	lv2:maximum 25 .

plug:input_group_1
	a pg:InputGroup ;
	lv2:name "Input" ;
	lv2:symbol "input_group_1" .

plug:input_group_2
	a pg:InputGroup ;
	lv2:name "Aux" ;
	lv2:symbol "input_group_2" .

plug:output_group_1
	a pg:OutputGroup ;
	lv2:name "Output" ;
	lv2:symbol "output_group_1" .

